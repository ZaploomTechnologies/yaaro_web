# Copy to .env — single file for dev + production
APP_ENV=dev
PORT=3001

# --- Dev (APP_ENV=dev) ---
DEV_NEXT_PUBLIC_API_URL=https://devapi.yaaro.fit/frontend/v1
DEV_NEXT_PUBLIC_IMAGE_URL=https://devapi.yaaro.fit
DEV_NEXT_PUBLIC_SITE_URL=https://dev.yaaro.fit
DEV_BACKEND_ORIGIN=https://devapi.yaaro.fit

# Local overrides:
# DEV_NEXT_PUBLIC_API_URL=http://localhost:3001/frontend/v1
# DEV_NEXT_PUBLIC_IMAGE_URL=http://127.0.0.1:3100
# DEV_NEXT_PUBLIC_SITE_URL=http://localhost:3001
# DEV_BACKEND_ORIGIN=http://127.0.0.1:3100

# --- Live (APP_ENV=production) ---
LIVE_NEXT_PUBLIC_API_URL=https://api.yaaro.fit/frontend/v1
LIVE_NEXT_PUBLIC_IMAGE_URL=https://api.yaaro.fit
LIVE_NEXT_PUBLIC_SITE_URL=https://yaaro.fit
LIVE_BACKEND_ORIGIN=https://api.yaaro.fit
